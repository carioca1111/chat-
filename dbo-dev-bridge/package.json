{
  "name": "dbo-dev-bridge",
  "version": "0.2.0",
  "description": "Windows one-click development bridge for local DBO Rox testing behind CGNAT",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "node-unrar-js": "^2.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.dborox.devbridge",
    "productName": "DBO Dev Bridge",
    "files": ["main.js", "autoprep.js", "preload.js", "index.html", "package.json"],
    "asar": false,
    "win": {"target": ["portable"]},
    "artifactName": "DBO-Dev-Bridge-Alpha-0.2-${version}-portable.${ext}"
  }
}
