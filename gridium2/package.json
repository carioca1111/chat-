{
  "name": "gridium-2",
  "version": "2.0.0-alpha.13.5",
  "private": true,
  "description": "Gridium 2 Alpha 1.3.5 - stable and optimized Hunt Control sessions",
  "main": "./out/main/index.js",
  "author": "Gridium",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run --exclude \"tests/long-running-soak.test.ts\"",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "test:electron": "vite build --config vite.smoke.config.ts && esbuild scripts/electron-lifecycle.ts --bundle --platform=node --external:electron --outfile=out/electron-lifecycle.cjs && electron out/electron-lifecycle.cjs"
  },
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.13.10",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.8",
    "esbuild": "^0.25.0"
  }
}
